{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "firepa-blind-ai-calibration-pass-a-v1",
  "title": "Blind AI calibration Pass A output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewer_id",
    "reviewer_type",
    "label_status",
    "protocol_version",
    "round_id",
    "reviews"
  ],
  "properties": {
    "reviewer_id": {"const": "gpt_5_6_thinking_calibration_r1"},
    "reviewer_type": {"const": "ai_assisted"},
    "label_status": {"const": "provisional_pseudolabel"},
    "protocol_version": {"const": "draft-v1"},
    "round_id": {"const": "blind_ai_calibration_r1"},
    "reviews": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/review"},
      "allOf": [
        {"contains": {"properties": {"case_id": {"const": "CASE-001"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"case_id": {"const": "CASE-002"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"case_id": {"const": "CASE-003"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"case_id": {"const": "CASE-004"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"case_id": {"const": "CASE-005"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"case_id": {"const": "CASE-006"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"case_id": {"const": "CASE-007"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "pass_a_visible_burn_scar",
        "pass_a_scar_confidence",
        "pass_a_event_association",
        "pass_a_competing_land_change",
        "pass_a_notes"
      ],
      "properties": {
        "case_id": {"enum": ["CASE-001", "CASE-002", "CASE-003", "CASE-004", "CASE-005", "CASE-006", "CASE-007"]},
        "pass_a_visible_burn_scar": {"enum": ["yes", "no", "ambiguous", "unobserved"]},
        "pass_a_scar_confidence": {"enum": ["high", "medium", "low", "not_applicable"]},
        "pass_a_event_association": {"enum": ["likely", "possible", "unlikely", "indeterminate"]},
        "pass_a_competing_land_change": {"enum": ["none_visible", "agriculture_or_harvest", "soil_exposure", "vegetation_phenology", "moisture_or_flooding", "cloud_or_haze", "shadow_or_atmosphere", "water", "urban_or_construction", "mixed", "unknown"]},
        "pass_a_notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
