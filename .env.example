# Este archivo solo documenta nombres de variables. El importador lee el
# entorno del proceso; no carga .env automáticamente.

# Raíz opcional; por defecto es el directorio actual al ejecutar el CLI.
FUEGOPA_PROJECT_ROOT=

# Elegir una fuente. No se inventa un endpoint ni una clave.
FIRMS_INPUT_PATH=
FIRMS_URL=
FIRMS_MAP_KEY=
FIRMS_START_DATE=2025-01-01
FIRMS_END_DATE=2025-04-30
FIRMS_AREA=cocle
FIRMS_SOURCES=
FIRMS_SOURCE_LABEL=LOCAL_CSV
FIRMS_BOUNDARY_PATH=data/reference/cocle.geojson
FIRMS_BOUNDARY_CRS=
FIRMS_RAW_DIR=data/raw
FIRMS_LOCAL_RAW_PATH=data/raw/firms_local_cocle_2025.csv
FIRMS_MANIFEST_DIR=data/raw/manifests
FIRMS_OUTPUT_PATH=data/processed/firms_cocle_2025_detections.csv
FIRMS_PROFILE_JSON=outputs/firms_cocle_2025_profile.json
FIRMS_PROFILE_MD=outputs/firms_cocle_2025_profile.md
FIRMS_TIMEOUT_SECONDS=30
FIRMS_MAX_RETRIES=2

# Rutas opcionales; las relativas se resuelven contra FUEGOPA_PROJECT_ROOT.
FUEGOPA_RAW_DIR=data/raw
FUEGOPA_INTERIM_DIR=data/interim
FUEGOPA_PROCESSED_DIR=data/processed
FUEGOPA_OUTPUTS_DIR=outputs
FUEGOPA_RAW_PATH=data/raw/firms_input.csv
FUEGOPA_PROCESSED_PATH=data/processed/firms_normalized.csv
FUEGOPA_REPORT_PATH=outputs/firms_quality_report.json

# Sensibilidad de clustering local; no activa ninguna descarga.
FUEGOPA_CLUSTERING_INPUT=data/processed/firms_cocle_2025_detections.csv
FUEGOPA_CLUSTERING_OUTPUT_DIR=outputs/clustering
FUEGOPA_CLUSTERING_FIGURES_DIR=outputs/figures/clustering
FUEGOPA_CLUSTERING_BOUNDARY=data/reference/cocle.geojson
FUEGOPA_CLUSTERING_BOUNDARY_CRS=

# Congelación provisional y muestreo óptico; no hace llamadas de red.
FUEGOPA_PROVISIONAL_SOURCE_DIR=outputs/clustering/r1500_t06
FUEGOPA_PROVISIONAL_SAMPLE_SIZE=30
FUEGOPA_PROVISIONAL_SEED=20260715

# Google Earth Engine: required only for the Sentinel-2 observability CLI.
# Use the project configured for the authenticated local EE account. Never
# commit a real project ID, token, service-account key, or other secret.
EARTH_ENGINE_PROJECT=
