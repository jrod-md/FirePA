---
import { t, type Locale } from "../i18n";

interface Props {
  src: string;
  alt: string;
  title: string;
  caption: string;
  figureId: string;
  longDescription: string;
  locale?: Locale;
}

const { src, alt, title, caption, figureId, longDescription, locale = "en" } = Astro.props;
const displayLabel = figureId.replace("figure-", `${t(locale, "FIGURE")} `);
---

<figure class="figure-plate" id={figureId}>
  <div class="figure-plate__image-wrap">
    <button
      type="button"
      class="figure-plate__zoom-trigger"
      aria-label={`${t(locale, "Inspect full resolution")}: ${displayLabel}`}
      data-zoom-trigger={figureId}
    >
      <img class="figure-plate__image" src={src} alt={alt} width="1600" height="900" loading="lazy" decoding="async" />
      <span class="figure-plate__zoom-badge" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
        <span>{t(locale, "Inspect full resolution")}</span>
      </span>
    </button>
  </div>
  <figcaption class="figure-plate__caption">
    <div class="figure-plate__info">
      <p class="figure-plate__label">{displayLabel}</p>
      <h3>{title}</h3>
      <p>{caption}</p>
    </div>
    <div class="figure-plate__actions">
      <button
        type="button"
        class="figure-plate__inspect-link"
        data-zoom-trigger={figureId}
      >
        {t(locale, "Inspect full plate ↗")}
      </button>
      <details class="figure-plate__details">
        <summary>{t(locale, "Scientific notes / description")}</summary>
        <p>{longDescription}</p>
        <a href={src} target="_blank" rel="noreferrer">{t(locale, "Open original PNG (1600×900) ↗")}</a>
      </details>
    </div>
  </figcaption>

  <dialog class="figure-dialog" id={`dialog-${figureId}`} aria-labelledby={`dialog-title-${figureId}`} data-figure-dialog>
    <div class="figure-dialog__frame">
      <div class="figure-dialog__header">
        <div class="figure-dialog__title-block">
          <p class="figure-dialog__label">{displayLabel} · {t(locale, "FROZEN SCIENTIFIC RECORD")}</p>
          <h3 id={`dialog-title-${figureId}`} class="figure-dialog__title">{title}</h3>
        </div>
        <div class="figure-dialog__controls">
          <a class="figure-dialog__raw-link" href={src} target="_blank" rel="noreferrer">{t(locale, "Raw PNG ↗")}</a>
          <button type="button" class="figure-dialog__close" aria-label={t(locale, "Close figure inspector")} data-dialog-close>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            <span>{t(locale, "Close (Esc)")}</span>
          </button>
        </div>
      </div>
      <div class="figure-dialog__image-container">
        <img class="figure-dialog__image" src={src} alt={alt} width="1600" height="900" />
      </div>
      <div class="figure-dialog__footer">
        <p class="figure-dialog__caption">{caption}</p>
        <p class="figure-dialog__desc">{longDescription}</p>
      </div>
    </div>
  </dialog>
</figure>

<script>
  interface FigureWindow extends Window {
    __figureDialogsInitialized?: boolean;
  }
  const figWin = window as FigureWindow;
  if (!figWin.__figureDialogsInitialized) {
    figWin.__figureDialogsInitialized = true;

    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement)?.closest('[data-zoom-trigger]');
      if (target) {
        const figId = target.getAttribute('data-zoom-trigger');
        const dialog = document.getElementById(`dialog-${figId}`) as HTMLDialogElement;
        if (dialog && typeof dialog.showModal === 'function') {
          dialog.showModal();
          document.body.style.overflow = 'hidden';
        }
      }

      const closeBtn = (e.target as HTMLElement)?.closest('[data-dialog-close]');
      if (closeBtn) {
        const dialog = closeBtn.closest('dialog') as HTMLDialogElement;
        if (dialog) {
          dialog.close();
          document.body.style.overflow = '';
        }
      }
    });

    document.querySelectorAll('[data-figure-dialog]').forEach((dialogNode) => {
      const dialog = dialogNode as HTMLDialogElement;
      dialog.addEventListener('close', () => {
        document.body.style.overflow = '';
      });
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) {
          dialog.close();
          document.body.style.overflow = '';
        }
      });
    });
  }
</script>
