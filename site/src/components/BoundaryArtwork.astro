---
import { cocleCartography } from "../data/cartography";
import { t, type Locale } from "../i18n";

interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
---

<figure class="boundary-art" aria-labelledby="boundary-art-title" aria-describedby="boundary-art-description">
  <svg viewBox={cocleCartography.viewBox} role="img">
    <title id="boundary-art-title">{t(locale, "Coclé, Panamá boundary context")}</title>
    <desc id="boundary-art-description">{t(locale, "The approved Coclé boundary is shown as a low-contrast territorial context. It contains no detections, coordinates, event marks, or operational map layer.")}</desc>
    <path class="boundary-art__layer boundary-art__layer--fill" d={cocleCartography.path}></path>
    <path class="boundary-art__layer boundary-art__layer--primary" d={cocleCartography.path}></path>
    <g class="boundary-art__layer--echo" aria-hidden="true">
      <path d={cocleCartography.path} transform="translate(1.4 -1.1)"></path>
    </g>
    <text class="boundary-art__label" x={cocleCartography.labelPoint[0]} y={cocleCartography.labelPoint[1]} transform="translate(12 -38)">COCLÉ</text>
  </svg>
  <figcaption class="sr-only">{t(locale, "Presentation-only cartographic derivative of the approved repository boundary. This territorial context is not a detection map or scientific output.")}</figcaption>
</figure>
