---
import { citations, manifest, methodology, projectSummary, provenance } from "../data/public";
import { routeFor, t, translateData, type Locale } from "../i18n";

interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;

const boundaryEntries = Object.entries(provenance.public_private_boundary);
const publicFiles = projectSummary.files;
const figureRecords = provenance.figure_provenance;
const hashShort = (value: string) => `${value.slice(0, 12)}…`;
---

<section id="reproduce" class="research-section inspect-section" aria-labelledby="inspect-title">
  <div class="site-frame">
    <div class="inspect-opening" data-reveal>
      <div class="inspect-opening__title">
        <p class="chapter-kicker"><span class="chapter-kicker__rule" aria-hidden="true"></span> {t(locale, "CHAPTER 07")}</p>
        <h2 id="inspect-title" class="inspect-title">{t(locale, "Inspect")} <em>{t(locale, "everything.")}</em></h2>
      </div>
      <div class="inspect-opening__note">
        <p class="section-label">{t(locale, "PUBLIC PACKAGE /")} {projectSummary.package_version}</p>
        <p>{t(locale, "The site is a reading layer over a frozen package. Its provenance is part of the evidence, not a technical afterthought.")}</p>
      </div>
    </div>

    <div class="inspect-overview" data-reveal>
      <div><p class="section-label">{t(locale, "PACKAGE")}</p><p class="inspect-overview__value">{projectSummary.package_version}</p><p>{t(locale, "Scientific freeze")} <code>{projectSummary.scientific_freeze_commit}</code></p></div>
      <div><p class="section-label">{t(locale, "GENERATOR")}</p><p class="inspect-overview__value">{provenance.generator.version}</p><p>{provenance.generator.command}</p></div>
      <div><p class="section-label">{t(locale, "NETWORK / EE")}</p><p class="inspect-overview__value">{t(locale, provenance.network_access ? "enabled" : "off")} / {t(locale, provenance.earth_engine_queries_made ? "queried" : "not queried")}</p><p>{t(locale, "Static public package. No backend required.")}</p></div>
    </div>

    <div class="inspect-grid" data-reveal>
      <div>
        <p class="section-label">{t(locale, "PUBLIC TREE")}</p>
        <ul class="package-tree">
          {publicFiles.map((file) => <li><code>{file}</code></li>)}
        </ul>
      </div>
      <div>
        <p class="section-label">{t(locale, "MANIFEST")}</p>
        <p>{manifest.files.length} {t(locale, "hashed public entries. Deterministic:")} <code>{t(locale, String(manifest.deterministic))}</code>.</p>
        <div class="hash-list">
          {manifest.files.slice(0, 6).map((file) => <div><code>{file.path}</code><span>{hashShort(file.sha256)}</span></div>)}
          <p class="hash-list__more">+ {manifest.files.length - 6} {t(locale, "more entries in the package manifest.")}</p>
        </div>
      </div>
    </div>

    <div class="inspect-grid inspect-grid--lower" data-reveal>
      <div>
        <p class="section-label">{t(locale, "FIGURE PROVENANCE")}</p>
        <div class="provenance-list">
          {figureRecords.map((figure) => <div><code>{figure.derivative_path}</code><span>{figure.transformation} · {figure.width}×{figure.height} · {t(locale, "same hash")} <code>{t(locale, figure.derivative_sha256 === figure.source_sha256 ? "yes" : "no")}</code></span></div>)}
        </div>
      </div>
      <div>
        <p class="section-label">{t(locale, "PUBLIC BOUNDARY")}</p>
        <dl class="boundary-list">
          {boundaryEntries.map(([key, value]) => <div><dt>{translateData(locale, key.replaceAll("_", " "))}</dt><dd>{t(locale, value ? "present" : "absent")}</dd></div>)}
        </dl>
        <p class="inspect-note">{t(locale, "The package exposes 19 public event fields. Private review identities, raw detection rows, SQLite, secrets and absolute paths remain outside the public boundary.")}</p>
      </div>
    </div>

    <div class="inspect-links">
      <a class="text-link" href={routeFor(locale, "methodology")}>{t(locale, "Read methodology")} <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={routeFor(locale, "sources")}>{t(locale, "Open sources & provenance")} <span aria-hidden="true">↗</span></a>
      <span class="inspect-links__meta">{citations.registry.source_count} {t(locale, "external source documents")} · {methodology.source_artifacts.length} {t(locale, "scientific source artifacts")}</span>
    </div>
  </div>
</section>
