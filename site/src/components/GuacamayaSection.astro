---
import FigurePlate from "./FigurePlate.astro";
import { citations, externalReferences, formatDecimal, formatHours, formatUtc, guacamayaTimeline } from "../data/public";
import { t, type Locale } from "../i18n";

interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const reference = externalReferences.features.find((feature) => feature.properties.reference_id === "REFERENCE-002");
const sources = citations.external_sources.filter((source) => source.incident_id === "REFERENCE-002");

// True-scale time axis: one hour is the same length everywhere on it.
const HOUR_MS = 3600000;
const LINK_WINDOW_HOURS = 6;
const clusters = guacamayaTimeline.clusters;
const axisStart = Date.parse(clusters[0].cluster_start_utc) - 5 * HOUR_MS;
const axisEnd = Date.parse(clusters[clusters.length - 1].cluster_end_utc) + 9 * HOUR_MS;
const AXIS_LEFT = 30;
const AXIS_RIGHT = 1170;
const AXIS_Y = 170;
const axisX = (time: number) => AXIS_LEFT + ((time - axisStart) / (axisEnd - axisStart)) * (AXIS_RIGHT - AXIS_LEFT);
const windowWidth = axisX(axisStart + LINK_WINDOW_HOURS * HOUR_MS) - AXIS_LEFT;
const axisMarks = clusters.map((cluster, index) => {
  const start = axisX(Date.parse(cluster.cluster_start_utc));
  const end = axisX(Date.parse(cluster.cluster_end_utc));
  const previousEnd = index > 0 ? axisX(Date.parse(clusters[index - 1].cluster_end_utc)) : null;
  return { cluster, start, end, width: Math.max(end - start, 4), previousEnd };
});
const midnights: Array<{ x: number; label: string }> = [];
for (let time = Math.ceil(axisStart / (24 * HOUR_MS)) * 24 * HOUR_MS; time < axisEnd; time += 24 * HOUR_MS) {
  midnights.push({ x: axisX(time), label: new Date(time).toISOString().slice(0, 10) });
}
---

<section id="guacamaya" class="research-section case-section case-section--dark" aria-labelledby="guacamaya-title">
  <div class="site-frame">
    <div class="case-opening" data-reveal>
      <div class="case-opening__title">
        <p class="chapter-kicker"><span class="chapter-kicker__rule" aria-hidden="true"></span> {t(locale, "CHAPTER 04 · CASE 01")}</p>
        <h2 id="guacamaya-title" class="case-title">{t(locale, "Guacamaya reads as")}<br /><em>{t(locale, "fragmentation.")}</em></h2>
      </div>
      <div class="case-opening__note">
        <p class="section-label">REFERENCE-002 · {reference?.properties.reference_name}</p>
        <p>{reference?.properties.official_match_count} {t(locale, "official matches across")} {reference?.properties.source_document_count} {t(locale, "public source documents. The result is relational evidence, not ground truth.")}</p>
      </div>
    </div>

    <div class="fragmentation-field" aria-label={t(locale, "Six separate Guacamaya provisional clusters and the five gaps between them")} data-reveal>
      <div class="time-axis">
        <svg viewBox="0 0 1200 300" role="img" aria-labelledby="guacamaya-axis-title guacamaya-axis-description">
          <title id="guacamaya-axis-title">{t(locale, "Six Guacamaya groups on a true time scale")}</title>
          <desc id="guacamaya-axis-description">{t(locale, "Each group is placed at its real UTC time. The shaded band after each group is the six-hour link window; every following group begins after that window has closed.")}</desc>
          {midnights.map((tick) => (
            <g class="time-axis__day">
              <line x1={tick.x} x2={tick.x} y1="34" y2="262"></line>
              <text x={tick.x + 8} y="46">{tick.label}</text>
            </g>
          ))}
          <line class="time-axis__base" x1={AXIS_LEFT} x2={AXIS_RIGHT} y1={AXIS_Y} y2={AXIS_Y}></line>
          {axisMarks.map(({ cluster, start, end, width, previousEnd }) => (
            <g class:list={{ "time-axis__group": true, "time-axis__group--possible": cluster.possible_chain_merge }}>
              <rect class="time-axis__window" x={end} y={AXIS_Y - 15} width={windowWidth} height="30"></rect>
              <line class="time-axis__window-end" x1={end + windowWidth} x2={end + windowWidth} y1={AXIS_Y - 15} y2={AXIS_Y + 15}></line>
              <rect class="time-axis__mark" x={start} y={AXIS_Y - 26} width={width} height="52" rx="1"></rect>
              <text class="time-axis__order" x={start} y="92">0{cluster.order}</text>
              <text class="time-axis__id" x={start} y="112">{cluster.public_event_id}</text>
              <text class="time-axis__meta" x={start} y="130">{cluster.detection_count} {t(locale, cluster.detection_count === 1 ? "detection" : "detections")} · {t(locale, cluster.day_count > 0 ? "day" : "night")}</text>
              {cluster.possible_chain_merge && <text class="time-axis__flag" x={start} y="212">possible_chain_merge</text>}
              {previousEnd !== null && (
                <g class="time-axis__gap">
                  <line x1={previousEnd} x2={start} y1="228" y2="228"></line>
                  <line x1={previousEnd} x2={previousEnd} y1="221" y2="235"></line>
                  <line x1={start} x2={start} y1="221" y2="235"></line>
                  <text x={(previousEnd + start) / 2} y="254">{formatDecimal(cluster.gap_from_previous_hours ?? 0)} h</text>
                </g>
              )}
            </g>
          ))}
        </svg>
      </div>
      <p class="time-axis__legend"><i aria-hidden="true"></i>{t(locale, "Shaded: the 6 h link window after each group's last detection. Every next group begins after it has closed. Times are UTC and to scale.")}</p>
      <div class="fragmentation-field__reading">
        <p class="section-label">{t(locale, "READING THE GAPS")}</p>
        <p>{t(locale, "The six matches are not animated into one incident. Five intervals exceed the six-hour clustering window, so the public result keeps six provisional units and preserves the fragmentation_possible caveat.")}</p>
      </div>
    </div>

    <div class="case-summary-line" data-reveal>
      <span><strong>{reference?.properties.official_match_count}</strong> {t(locale, "official matches")}</span>
      <span><strong>{reference?.properties.matched_cluster_count}</strong> {t(locale, "separate provisional clusters")}</span>
      <span><strong>{formatHours(reference?.properties.temporal_span_hours ?? null)}</strong> {t(locale, "observed span")}</span>
      <span><strong>{reference?.properties.inter_cluster_gaps_gt_6h}</strong> {t(locale, "gaps > 6 h")}</span>
    </div>

    <details class="case-ledger" data-reveal>
      <summary>{t(locale, "Inspect the six-record timeline")}</summary>
      <div class="timeline-reading">
        <div>
        <p class="section-label">{t(locale, "FROZEN TIMELINE · 2025-01-23 → 2025-01-27 UTC")}</p>
        <ol class="case-timeline">
          {guacamayaTimeline.clusters.map((cluster) => (
            <li class:list={{ "case-timeline__item": true, "case-timeline__item--possible": cluster.possible_chain_merge }}>
              <div class="case-timeline__rail" aria-hidden="true"><span></span></div>
              <div class="case-timeline__body">
                <div class="case-timeline__topline"><span class="case-timeline__order">0{cluster.order}</span><span class="case-timeline__id">{cluster.public_event_id}</span><span class="case-timeline__daynight">{t(locale, cluster.day_count > 0 ? "day" : "night")}</span></div>
                <p>{formatUtc(cluster.cluster_start_utc)} → {formatUtc(cluster.cluster_end_utc)} · {cluster.detection_count} FIRMS {t(locale, "detections")} · {t(locale, "mean")} {formatDecimal(cluster.mean_frp_mw)} MW / {t(locale, "max")} {formatDecimal(cluster.max_frp_mw)} MW</p>
                {cluster.gap_from_previous_hours !== null && <p class="case-timeline__gap">{formatDecimal(cluster.gap_from_previous_hours)} {t(locale, "h since previous cluster")}</p>}
                {cluster.possible_chain_merge && <p class="case-timeline__caveat">possible_chain_merge = true</p>}
              </div>
            </li>
          ))}
        </ol>
        </div>
        <div class="timeline-reading__note">
          <p class="section-label">{t(locale, "SOURCE RECORD")}</p>
          <p>{t(locale, "Each cluster remains a separate provisional analytical unit. Day/night and FRP values are descriptive record fields, not an incident classification.")}</p>
          <p class="case-source-note">{t(locale, "Sources:")} {sources.map((source) => <a href={source.url} target="_blank" rel="noreferrer">{source.source_id}</a>).reduce((items, item, index) => index === 0 ? [item] : [...items, ", ", item], [])}</p>
        </div>
      </div>
    </details>

    <div class="case-evidence-heading" data-reveal>
      <p class="section-label">{t(locale, "SUPPORTING FROZEN EVIDENCE")}</p>
      <p>{t(locale, "Two preserved research plates document the timeline and descriptive FRP sequence without merging the records into a continuous event.")}</p>
    </div>

    <div class="case-figures" data-reveal>
      <FigurePlate
        figureId="figure-04"
        src="/figures/04_guacamaya_timeline.png"
        alt={t(locale, "Frozen timeline showing six Guacamaya matches, their gaps and day or night observations.")}
        title={t(locale, "Six matches, kept separate")}
        caption={t(locale, "The primary case figure. It shows the six public event IDs, their temporal gaps, day or night observations and the fragmentation caveat.")}
        longDescription={t(locale, "The frozen Guacamaya timeline spans 2025-01-23 through 2025-01-27 UTC. Six provisional clusters are shown as separate records, with five gaps above six hours and one possible chain-merge flag.")}
        locale={locale}
      />
      <FigurePlate
        figureId="figure-05"
        src="/figures/05_guacamaya_frp_distribution.png"
        alt={t(locale, "Frozen descriptive FRP sequence for the six Guacamaya matches.")}
        title={t(locale, "FRP as descriptive sequence")}
        caption={t(locale, "Maximum and mean FRP values for the six matched public events. The values are descriptive and are not a severity scale.")}
        longDescription={t(locale, "The figure plots the six Guacamaya public event IDs in temporal order with maximum and mean FRP values. It does not infer cause, intensity class or continuity between observations.")}
        locale={locale}
      />
    </div>
    <p class="case-explore" data-reveal>
      <a href="/explorar/?caso=guacamaya" hreflang="es">{t(locale, "Explore this case in 3D →")}</a>
      <span>{t(locale, "Exploratory Sentinel-2 view in Spanish, outside Scientific Pilot v1.")}</span>
    </p>
  </div>
</section>
