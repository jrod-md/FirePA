---
import { counts, projectSummary } from "../data/public";
import { t, translateData, type Locale } from "../i18n";

interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
---

<section id="limits" class="research-section limits-section" aria-labelledby="limits-title">
  <div class="site-frame">
    <div class="limits-opening" data-reveal>
      <div>
        <p class="chapter-kicker"><span class="chapter-kicker__rule" aria-hidden="true"></span> {t(locale, "CHAPTER 06")}</p>
        <h2 id="limits-title" class="limits-title">{t(locale, "The evidence stops")} <em>{t(locale, "here.")}</em></h2>
      </div>
      <div class="limits-opening__note">
        <p class="section-label">{t(locale, "LIMITS ARE PART OF THE RESULT")}</p>
        <p>{t(locale, "This release is deliberately descriptive. What is absent is not a hidden layer waiting behind the interface.")}</p>
      </div>
    </div>

    <div class="limits-statement" data-reveal>
      <p class="limits-statement__rule"><span>{t(locale, "No confirmed classification.")}</span><span>{t(locale, "No ground truth.")}</span><span>{t(locale, "No predictive severity.")}</span></p>
      <p class="limits-statement__lead">{t(locale, "A static analysis of provisional thermal events in Coclé using FIRMS and Sentinel-2 evidence.")}</p>
    </div>

    <div class="limits-columns" data-reveal>
      <div>
        <p class="section-label">{t(locale, "FORMAL STATUS")}</p>
        <dl class="limits-facts">
          <div><dt>{t(locale, "Formal human observations")}</dt><dd>{counts.formal_human_observations}</dd></div>
          <div><dt>{t(locale, "Ground truth")}</dt><dd>{t(locale, "None")}</dd></div>
          <div><dt>{t(locale, "Predictive model")}</dt><dd>{t(locale, "None")}</dd></div>
          <div><dt>{t(locale, "Severity class")}</dt><dd>{t(locale, "None")}</dd></div>
        </dl>
      </div>
      <div>
        <p class="section-label">{t(locale, "DO NOT INFER")}</p>
        <ul class="editorial-list editorial-list--limits">
          {projectSummary.limitations.map((limitation) => <li><span aria-hidden="true">×</span><span>{translateData(locale, limitation)}</span></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
