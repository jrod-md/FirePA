---
import FigurePlate from "./FigurePlate.astro";
import { citations, externalReferences, formatExact, formatMeters } from "../data/public";

const reference = externalReferences.features.find((feature) => feature.properties.reference_id === "REFERENCE-001");
const source = citations.external_sources.find((item) => item.source_id === "SOURCE-001");
const officialThresholdM = reference?.properties.official_matching_radius_m ?? 0;
const nearestSignalM = reference?.properties.nearest_documented_contemporary_signal_m ?? 0;
const scaleStartX = 60;
const scaleEndX = 1440;
const scaleMaxM = 15000;
const scaleX = (metres: number) => scaleStartX + (metres / scaleMaxM) * (scaleEndX - scaleStartX);
const thresholdX = scaleX(officialThresholdM);
const tenKilometresX = scaleX(10000);
const signalX = scaleX(nearestSignalM);
const nearestSignalKm = (nearestSignalM / 1000).toFixed(6);
---

<section id="picachos" class="research-section case-section picachos-section" aria-labelledby="picachos-title">
  <div class="site-frame">
    <div class="case-opening case-opening--light" data-reveal>
      <div class="case-opening__title">
        <p class="chapter-kicker"><span class="chapter-kicker__rule" aria-hidden="true"></span> CHAPTER 05 · CASE 02</p>
        <h2 id="picachos-title" class="case-title">Los Picachos marks a<br /><em>threshold miss.</em></h2>
      </div>
      <div class="case-opening__note">
        <p class="section-label">REFERENCE-001 · {reference?.properties.reference_name}</p>
        <p>The official comparison returns zero matches inside its frozen rule. That is a statement about this comparison, not a statement that no fire, activity or signal existed.</p>
      </div>
    </div>

    <div id="picachos-distance-scale" class="distance-reading" data-reveal>
      <div class="distance-reading__heading">
        <div>
          <p class="section-label">OFFICIAL MATCHING THRESHOLD</p>
          <p class="distance-reading__value">{formatMeters(officialThresholdM)}</p>
        </div>
        <div>
          <p class="section-label">NEAREST DOCUMENTED CONTEMPORARY SIGNAL</p>
          <p class="distance-reading__value">{formatExact(nearestSignalM)}<small> m</small></p>
        </div>
      </div>

      <svg class="distance-scale" viewBox="0 0 1500 260" role="img" aria-labelledby="picachos-scale-title picachos-scale-description" focusable="false">
        <title id="picachos-scale-title">Los Picachos official threshold and nearest documented signal</title>
        <desc id="picachos-scale-description">Distance scale from zero to 15 kilometres. The official threshold is {formatMeters(officialThresholdM)} with {reference?.properties.official_match_count} official matches. The nearest documented contemporary signal is {formatExact(nearestSignalM)} metres, beyond the official threshold.</desc>

        <!-- Official matching zone (0 to 5 km) -->
        <rect class="distance-scale__official-zone" x={scaleStartX} y="78" width={thresholdX - scaleStartX} height="84" rx="2"></rect>
        <text class="distance-scale__zone-label" x={(scaleStartX + thresholdX) / 2} y="122">{reference?.properties.official_match_count} OFFICIAL MATCHES</text>
        <text class="distance-scale__zone-sub" x={(scaleStartX + thresholdX) / 2} y="144">5,000 m matching zone</text>

        <!-- Distance baseline track -->
        <line class="distance-scale__track" x1={scaleStartX} y1="162" x2={scaleEndX} y2="162" pathLength="1"></line>

        <!-- 0 km origin -->
        <g class="distance-scale__tick distance-scale__tick--origin">
          <line x1={scaleStartX} y1="150" x2={scaleStartX} y2="174"></line>
          <circle cx={scaleStartX} cy="162" r="5"></circle>
          <text x={scaleStartX} y="206">0 km</text>
        </g>

        <!-- 5 km official threshold boundary -->
        <g class="distance-scale__tick distance-scale__tick--threshold">
          <line x1={thresholdX} y1="46" x2={thresholdX} y2="178" stroke-dasharray="3 3"></line>
          <circle cx={thresholdX} cy="162" r="7"></circle>
          <text class="distance-scale__annotation" x={thresholdX} y="34">OFFICIAL RULE</text>
          <text class="distance-scale__threshold-val" x={thresholdX} y="206">5 km</text>
        </g>

        <!-- 10 km scale tick -->
        <g class="distance-scale__tick distance-scale__tick--mid">
          <line x1={tenKilometresX} y1="152" x2={tenKilometresX} y2="172"></line>
        </g>

        <!-- 10.400826 km nearest signal mark -->
        <g class="distance-scale__tick distance-scale__tick--signal">
          <line x1={signalX} y1="46" x2={signalX} y2="178"></line>
          <circle cx={signalX} cy="162" r="8"></circle>
          <text class="distance-scale__annotation distance-scale__annotation--signal" x={signalX} y="34">CLOSEST SIGNAL</text>
          <text class="distance-scale__signal-value" x={signalX} y="62">{nearestSignalKm} km</text>
          <text class="distance-scale__signal-sub" x={signalX} y="206">10,400.826 m</text>
        </g>

        <!-- 15 km scale end -->
        <g class="distance-scale__tick distance-scale__tick--end">
          <line x1={scaleEndX} y1="150" x2={scaleEndX} y2="174"></line>
          <circle cx={scaleEndX} cy="162" r="5"></circle>
          <text x={scaleEndX} y="206">15 km</text>
        </g>
      </svg>

      <div class="distance-reading__result">
        <p><strong>{reference?.properties.official_match_count}</strong><span>official matches inside {formatMeters(officialThresholdM)}</span></p>
        <div><p class="section-label">DIAGNOSTIC</p><code>{reference?.properties.diagnostic}</code><p>Official match count is zero because the documented nearest contemporary signal is outside the 5 km matching threshold.</p></div>
      </div>
    </div>

    <div class="diagnostic-caveat" data-reveal>
      <p><strong>Read literally:</strong> `official_match_count = 0` does not mean no fire, no activity and no thermal signal. It means the frozen 5,000 m inclusive spatial rule found no match for this external reference.</p>
      <p><a href={source?.url} target="_blank" rel="noreferrer">{source?.source_id} · {source?.publisher}</a></p>
    </div>

    <div class="picachos-plate" data-reveal>
      <FigurePlate
        figureId="figure-06"
        src="/figures/06_los_picachos_diagnostic.png"
        alt="Frozen Los Picachos diagnostic showing zero official matches at 5 kilometres and the nearest documented contemporary signal beyond that threshold."
        title="A zero with a boundary"
        caption="The frozen diagnostic figure preserves the official 5 km rule and the wider diagnostic context. The structured public result is SPATIAL_THRESHOLD_MISS."
        longDescription="The frozen figure shows the approximate Los Picachos reference anchor, the official 5 km matching radius, wider diagnostic context and the nearest documented contemporary signal at 10.400826 km. The page does not turn the wider context into a new control or recompute the result."
      />
    </div>
  </div>
</section>
