---
import BaseLayout from "../layouts/BaseLayout.astro";
import BurnTransition from "./BurnTransition.astro";
import EmberTerritory from "./EmberTerritory.astro";
import EventExplorer from "./EventExplorer.astro";
import GuacamayaSection from "./GuacamayaSection.astro";
import InspectSection from "./InspectSection.astro";
import LimitsSection from "./LimitsSection.astro";
import OpticalSection from "./OpticalSection.astro";
import PicachosSection from "./PicachosSection.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { counts, events, formatCount, period, projectSummary } from "../data/public";
import { pageMeta, t, type Locale } from "../i18n";

interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const periodLabel = `${period.start} → ${period.end}`;
const [title, description] = pageMeta[locale].home;
const notRetained = counts.firms_raw_detections - counts.firms_processed_detections;
const retainedShare = ((counts.firms_processed_detections / counts.firms_raw_detections) * 100).toFixed(3);
const groupSizes = events.features.map((feature) => feature.properties.detection_count).sort((a, b) => b - a);
const largestGroup = groupSizes[0];
const multiCount = groupSizes.filter((size) => size > 1).length;
const columnPath = (from: number, to: number) =>
  `M${from} ${largestGroup}` + groupSizes.slice(from, to).map((size, index) => `V${largestGroup - size}H${from + index + 1}`).join("") + `V${largestGroup}Z`;
---

<BaseLayout title={title} description={description} locale={locale} page="home">
  <a class="skip-link" href="#main-content">{t(locale, "Skip to content")}</a>
  <SiteHeader locale={locale} page="home" />

  <main id="main-content" class="publication-main">
    <div class="burn-stage" data-burn-stage>
      <section id="research" class="ember-hero" aria-labelledby="hero-question" data-burn-surface>
        <EmberTerritory locale={locale} />
        <div class="site-frame ember-hero__copy" data-burn-parallax>
          <p class="ember-hero__eyebrow"><span class="eyebrow__rule" aria-hidden="true"></span> {t(locale, "A REMOTE-SENSING RESEARCH PILOT")}</p>
          <h1 id="hero-question" class="ember-hero__question">
            <span>{t(locale, "Can thermal signals")}</span>
            <span>{t(locale, "tell us what happened")}</span>
            <span>{locale === "en" ? <>on <em>the ground?</em></> : <em>{t(locale, "on the ground?")}</em>}</span>
          </h1>
          <p class="ember-hero__definition">{t(locale, "A static analysis of provisional thermal events in Coclé using FIRMS and Sentinel-2 evidence.")}</p>
          <div class="hero-meta ember-hero__meta" aria-label={t(locale, "Study frame")}>
            <span class="hero-meta__item"><span class="hero-meta__mark" aria-hidden="true"></span>{projectSummary.study_area}</span>
            <span class="hero-meta__divider" aria-hidden="true"></span>
            <span class="hero-meta__item"><span class="hero-meta__calendar" aria-hidden="true"></span><time datetime={period.start}>{period.start}</time><span aria-hidden="true">→</span><time datetime={period.end}>{period.end}</time></span>
            <span class="hero-meta__divider" aria-hidden="true"></span>
            <span class="hero-meta__item ember-hero__boundary">{t(locale, "NOT REAL-TIME. NOT OPERATIONAL.")}</span>
          </div>
        </div>
        <p class="ember-hero__scroll" aria-hidden="true">↓ {t(locale, "SCROLL")} ↓</p>
      </section>

      <div class="burn-under">
        <section id="evidence-chain" class="reduction-chapter" aria-labelledby="chapter-title">
          <div class="site-frame reduction-chapter__head">
            <div>
              <p class="chapter-kicker"><span class="chapter-kicker__rule" aria-hidden="true"></span> {t(locale, "CHAPTER 01")}</p>
              <h2 id="chapter-title" class="reduction-chapter__title">{t(locale, "From")} <em>{t(locale, "signal")}</em> {t(locale, "to")} <em>{t(locale, "event")}</em></h2>
            </div>
            <aside class="reduction-chapter__context" aria-label={t(locale, "Pipeline context")}>
              <p class="section-label">{t(locale, "THE PIPELINE")}</p>
              <p>{t(locale, "A three-step reduction from audited FIRMS records to provisional thermal events, using the frozen processing and spatio-temporal clustering configuration")} <code>{counts.configuration_id}</code>.</p>
            </aside>
          </div>

          <div class="site-frame reduction-ledger">
            <article class="reduction-row" aria-labelledby="stage-one-title">
              <div class="reduction-row__figure">
                <p class="stage-index">{t(locale, "STEP 01")}</p>
                <p class="reduction-row__number">{formatCount(counts.firms_raw_detections)}</p>
                <h3 id="stage-one-title" class="reduction-row__label">{t(locale, "AUDITED FIRMS")} {t(locale, "RAW DETECTIONS")}</h3>
              </div>
              <div class="reduction-row__graphic">
                <div class="reduction-bar" role="img" aria-label={`${formatCount(counts.firms_processed_detections)} ${t(locale, "retained")}, ${formatCount(notRetained)} ${t(locale, "not retained")}`}>
                  <span class="reduction-bar__kept" style={`width:${retainedShare}%`}></span>
                  <span class="reduction-bar__dropped"></span>
                </div>
                <p class="reduction-row__note reduction-row__note--end"><strong>{formatCount(notRetained)}</strong> {t(locale, "not retained by the audit, which keeps records with valid schema, coordinates, timestamps and study dates inside the Coclé boundary")}</p>
              </div>
            </article>

            <article class="reduction-row" aria-labelledby="stage-two-title">
              <div class="reduction-row__figure">
                <p class="stage-index">{t(locale, "STEP 02")}</p>
                <p class="reduction-row__number">{formatCount(counts.firms_processed_detections)}</p>
                <h3 id="stage-two-title" class="reduction-row__label">{t(locale, "PROCESSED")} {t(locale, "DETECTIONS")}</h3>
              </div>
              <div class="reduction-row__graphic">
                <div class="reduction-bar reduction-bar--solid" style={`width:${retainedShare}%`} aria-hidden="true"><span class="reduction-bar__kept" style="width:100%"></span></div>
                <p class="reduction-row__note">{t(locale, "Filtering removes records. The next step removes nothing: it only decides which detections belong together.")}</p>
              </div>
            </article>

            <article class="reduction-row reduction-row--events" aria-labelledby="stage-three-title">
              <div class="reduction-row__figure">
                <p class="stage-index">{t(locale, "STEP 03")}</p>
                <p class="reduction-row__number">{formatCount(counts.provisional_thermal_events)}</p>
                <h3 id="stage-three-title" class="reduction-row__label">{t(locale, "PROVISIONAL")} {t(locale, "THERMAL EVENTS")}</h3>
              </div>
              <div class="reduction-row__graphic">
                <figure class="group-columns" style={`width:${retainedShare}%`}>
                  <svg viewBox={`0 0 ${groupSizes.length} ${largestGroup}`} preserveAspectRatio="none" role="img" aria-labelledby="group-columns-title group-columns-description">
                    <title id="group-columns-title">{t(locale, "Detections per provisional event")}</title>
                    <desc id="group-columns-description">{formatCount(counts.provisional_thermal_events)} {t(locale, "columns, one per provisional event, sorted by size. Column height is the number of detections in the group.")} {counts.multi_detection_events} {t(locale, "groups of")} 2–{largestGroup}; {counts.singletons} {t(locale, "singletons")}.</desc>
                    <path class="group-columns__multi" d={columnPath(0, multiCount)}></path>
                    <path class="group-columns__single" d={columnPath(multiCount, groupSizes.length)}></path>
                    {Array.from({ length: largestGroup - 1 }, (_, index) => <line class="group-columns__unit" x1="0" x2={groupSizes.length} y1={index + 1} y2={index + 1}></line>)}
                  </svg>
                  <figcaption class="group-columns__key">
                    <span style={`flex:${multiCount}`}><strong>{counts.multi_detection_events}</strong> {t(locale, "groups of")} 2–{largestGroup} {t(locale, "detections")}</span>
                    <span style={`flex:${groupSizes.length - multiCount}`}><strong>{counts.singletons}</strong> {t(locale, "singletons")}</span>
                  </figcaption>
                </figure>
                <p class="reduction-row__note">{t(locale, "The same 1,185 detections, regrouped. One column per provisional event; height is the number of detections in the group.")}</p>
              </div>
            </article>
          </div>

          <div class="site-frame reduction-chapter__footer">
            <p>{t(locale, "Counts reflect this study area and time window only:")} {projectSummary.study_area} · {periodLabel}</p>
            <p>{t(locale, "CLUSTERING:")} <code>{counts.configuration_id}</code></p>
            <p>{t(locale, "Bar widths share one scale. Columns are drawn from the public event table.")}</p>
          </div>
        </section>
        <div class="burn-under__spacer" aria-hidden="true"></div>
      </div>
    </div>

    <EventExplorer locale={locale} />
    <OpticalSection locale={locale} />
    <GuacamayaSection locale={locale} />
    <PicachosSection locale={locale} />
    <LimitsSection locale={locale} />
    <InspectSection locale={locale} />
  </main>

  <SiteFooter locale={locale} />
  <BurnTransition />
</BaseLayout>
