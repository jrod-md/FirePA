---
import BaseLayout from "../layouts/BaseLayout.astro";
import BoundaryArtwork from "./BoundaryArtwork.astro";
import ConceptField from "./ConceptField.astro";
import EventExplorer from "./EventExplorer.astro";
import GuacamayaSection from "./GuacamayaSection.astro";
import InspectSection from "./InspectSection.astro";
import LimitsSection from "./LimitsSection.astro";
import OpticalSection from "./OpticalSection.astro";
import PicachosSection from "./PicachosSection.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { counts, formatCount, period, projectSummary } from "../data/public";
import { pageMeta, t, type Locale } from "../i18n";

interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const periodLabel = `${period.start} → ${period.end}`;
const [title, description] = pageMeta[locale].home;
---

<BaseLayout title={title} description={description} locale={locale} page="home">
  <a class="skip-link" href="#main-content">{t(locale, "Skip to content")}</a>
  <SiteHeader locale={locale} page="home" />

  <main id="main-content" class="opening-system">
    <section id="research" class="hero-section opening-hero" aria-labelledby="hero-question">
      <div class="site-frame opening-hero__copy">
        <p class="opening-hero__eyebrow"><span class="eyebrow__rule" aria-hidden="true"></span> {t(locale, "A REMOTE-SENSING RESEARCH PILOT")}</p>
        <p class="opening-hero__wordmark" aria-label="FirePA">FirePA</p>
        <h1 id="hero-question" class="opening-hero__question">
          <span>{t(locale, "Can thermal signals")}</span>
          <span>{t(locale, "tell us what happened")}</span>
          <span>{locale === "en" ? <>on <em>the ground?</em></> : <em>{t(locale, "on the ground?")}</em>}</span>
        </h1>

        <div class="hero-meta opening-hero__meta" aria-label={t(locale, "Study frame")}>
          <span class="hero-meta__item"><span class="hero-meta__mark" aria-hidden="true"></span>{projectSummary.study_area}</span>
          <span class="hero-meta__divider" aria-hidden="true"></span>
          <span class="hero-meta__item"><span class="hero-meta__calendar" aria-hidden="true"></span><time datetime={period.start}>{period.start}</time><span aria-hidden="true">→</span><time datetime={period.end}>{period.end}</time></span>
        </div>

        <p class="hero-definition opening-hero__definition">{t(locale, "A static analysis of provisional thermal events in Coclé using FIRMS and Sentinel-2 evidence.")}</p>
        <p class="hero-boundary opening-hero__boundary">{t(locale, "NOT REAL-TIME. NOT OPERATIONAL.")}</p>
      </div>

      <div class="hero-cartography opening-hero__territory">
        <BoundaryArtwork locale={locale} />
      </div>
    </section>

    <section id="evidence-chain" class="chapter-section opening-chapter" aria-labelledby="chapter-title">
      <div class="site-frame opening-chapter__head">
        <div>
          <p class="chapter-kicker"><span class="chapter-kicker__rule" aria-hidden="true"></span> {t(locale, "CHAPTER 01")}</p>
          <h2 id="chapter-title" class="chapter-title opening-chapter__title">{t(locale, "From")} <em>{t(locale, "signal")}</em><br />{t(locale, "to")} <em>{t(locale, "event")}</em></h2>
        </div>
        <aside class="opening-chapter__context" aria-label={t(locale, "Pipeline context")}>
          <p class="chapter-aside__label">{t(locale, "THE PIPELINE")}</p>
          <p>{t(locale, "A three-step reduction from audited FIRMS records to provisional thermal events, using the frozen processing and spatio-temporal clustering configuration")} <code>{counts.configuration_id}</code>.</p>
        </aside>
      </div>

      <div class="site-frame opening-chapter__exhibit" aria-describedby="pipeline-field-disclosure">
        <div class="opening-chapter__stages">
          <article class="opening-stage opening-stage--one" aria-labelledby="stage-one-title">
            <p class="stage-index">{t(locale, "STEP 01")}</p>
            <p class="pipeline-number">{formatCount(counts.firms_raw_detections)}</p>
            <h3 id="stage-one-title" class="stage-label">{t(locale, "AUDITED FIRMS")}<br />{t(locale, "RAW DETECTIONS")}</h3>
          </article>
          <span class="opening-chapter__connector" aria-hidden="true"></span>
          <article class="opening-stage opening-stage--two" aria-labelledby="stage-two-title">
            <p class="stage-index">{t(locale, "STEP 02")}</p>
            <p class="pipeline-number">{formatCount(counts.firms_processed_detections)}</p>
            <h3 id="stage-two-title" class="stage-label">{t(locale, "PROCESSED")}<br />{t(locale, "DETECTIONS")}</h3>
          </article>
          <span class="opening-chapter__connector" aria-hidden="true"></span>
          <article class="opening-stage opening-stage--three" aria-labelledby="stage-three-title">
            <p class="stage-index">{t(locale, "STEP 03")}</p>
            <p class="pipeline-number">{formatCount(counts.provisional_thermal_events)}</p>
            <h3 id="stage-three-title" class="stage-label">{t(locale, "PROVISIONAL")}<br />{t(locale, "THERMAL EVENTS")}</h3>
          </article>
        </div>
        <div class="opening-chapter__field"><ConceptField /></div>
      </div>

      <div class="site-frame chapter-note opening-chapter__footer">
        <p class="chapter-note__asterisk" aria-hidden="true">*</p>
        <p>{t(locale, "Counts reflect this study area and time window only:")} {projectSummary.study_area} · {periodLabel}</p>
        <p class="chapter-note__method">{t(locale, "CLUSTERING:")} <code>{counts.configuration_id}</code></p>
        <p id="pipeline-field-disclosure" class="chapter-note__explanation">
          {t(locale, "Conceptual explanatory visualization, non-geographic.")}
          <span class="sr-only">{t(locale, "Density and grouping marks are authored to communicate reduction; they are not one mark per actual observation.")}</span>
        </p>
      </div>
    </section>

    <EventExplorer locale={locale} />
    <OpticalSection locale={locale} />
    <GuacamayaSection locale={locale} />
    <PicachosSection locale={locale} />
    <LimitsSection locale={locale} />
    <InspectSection locale={locale} />
  </main>

  <SiteFooter locale={locale} />
</BaseLayout>
